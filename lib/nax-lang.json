{
  "name": "nax",
  "scopeName": "source.nax",
  "aliases": ["nature"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nax",
          "match": "//.*$"
        },
        {
          "name": "comment.block.nax",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.nax",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.nax",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.nax",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nax",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.backtick.nax",
          "begin": "`",
          "end": "`"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.nax",
          "match": "\\b(var|type|fn|import|new)\\b"
        },
        {
          "name": "keyword.control.nax",
          "match": "\\b(if|else|for|in|break|continue|return|match|select)\\b"
        },
        {
          "name": "keyword.error.nax",
          "match": "\\b(try|catch|throw)\\b"
        },
        {
          "name": "keyword.concurrent.nax",
          "match": "\\b(go)\\b"
        },
        {
          "name": "constant.language.boolean.nax",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "keyword.operator.type.nax",
          "match": "\\b(as|is)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.nax",
          "match": "\\b(void|any|null|anyptr|bool|string|int|uint|float|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64)\\b"
        },
        {
          "name": "storage.type.composite.nax",
          "match": "\\b(struct|chan|arr|vec|map|set|tup|ptr|rawptr|enum|union)\\b"        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.nax",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        },
        {
          "name": "meta.function.declaration.nax",
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "keyword.declaration.function.nax" },
            "2": { "name": "entity.name.function.nax" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.nax",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "constant.numeric.float.nax",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.hex.nax",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.nax",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.octal.nax",
          "match": "\\b0o[0-7]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.nax",
          "match": "[+\\-*/%]|\\+\\+|\\-\\-"
        },
        {
          "name": "keyword.operator.comparison.nax",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.nax",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.nax",
          "match": "=|\\+=|\\-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.bitwise.nax",
          "match": "&|\\||\\^|~|<<|>>"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.nax",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.terminator.nax",
          "match": "\\."
        },
        {
          "name": "punctuation.accessor.nax",
          "match": "\\."
        },
        {
          "name": "punctuation.section.braces.nax",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.nax",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.nax",
          "match": "[()]"
        }
      ]
    }
  }
}